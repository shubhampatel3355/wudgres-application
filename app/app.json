{
  "expo": {
    "name": "WudGres",
    "slug": "wudgres",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "description": "WudGres — Premium Door Collections. Browse, customize and price WudGres doors.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1612"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#D4AF37"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wudgres.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan NFC tags on WudGres doors.",
        "NSPhotoLibraryUsageDescription": "Used to upload profile and product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1612"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.wudgresreal",
      "googleServicesFile": "./google-services.json",
      "resizeableActivity": true,
      "versionCode": 33,
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow WudGres to use your location."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bdd23acb-7d71-4d9c-8f7d-9542d306d76c"
      }
    },
    "owner": "wudgres-v2"
  }
}
